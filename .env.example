# ============================================================
# CAVDAX Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in your values before running.
#
#   cp .env.example .env
#
# NEVER commit your actual .env file to git — it is already in .gitignore.
# This .env.example file IS safe to commit — it contains no real secrets.
# ============================================================


# ── FalkorDB Connection ──────────────────────────────────────────────────────
# Host where FalkorDB is running.
#   Local dev (bare metal):    localhost
#   Docker Compose:            falkordb   (use the service name)
#   Hosted / managed:          your-instance.falkordb.cloud
FALKORDB_HOST=localhost

# FalkorDB Redis-compatible port (default: 6379)
FALKORDB_PORT=6379

# Name of the FalkorDB graph that CAVDAX uses as its causal DAG store.
# You can have separate graphs per environment (e.g. cavdax_staging_graph).
FALKORDB_GRAPH_NAME=cavdax_core_graph


# ── MCP API Bearer Token ─────────────────────────────────────────────────────
# This token protects all write endpoints on the CAVDAX server:
#
#   POST /api/seed            — seed demo graph data
#   POST /api/ingest          — ingest ADR files into FalkorDB
#   POST /api/ingest-source   — webhook: ingest commit / package / issue / codeowners
#   POST /api/mcp/messages    — MCP SSE remote tool call execution
#   POST /api/act-iv-revalidate — force-revalidate a decision node
#   POST /api/reset           — wipe the graph (destructive)
#
# How to use:
#   Every protected request must include this header:
#     Authorization: Bearer <your-token-here>
#
# How to generate a strong token (run once in your terminal):
#   openssl rand -hex 32
#
# Leave blank in local dev — auth is automatically skipped and a warning
# is printed at boot. Set it for any environment exposed to the internet.
MCP_API_TOKEN=


# ── Server Port ───────────────────────────────────────────────────────────────
# Port the Express backend (apps/server/index.js) listens on.
# Default: 3000
# Production tip: Caddy / Nginx sits in front on 443 and proxies to this port.
PORT=3000


# ── CAVDAX Tier ───────────────────────────────────────────────────────────────
# Controls feature availability and rate limits visible in /api/dev/tier-check.
# Valid values: free | pro | enterprise
#
#   free:       100 req/min, stdio MCP only, local FalkorDB
#   pro:        300 req/min, SSE remote MCP, all source types, webhook ingestion
#   enterprise: unlimited, multi-tenant, RBAC, SLA
#
# Default: free
CAVDAX_TIER=free

# ── Hackathon Evaluation Mode ─────────────────────────────────────────────────
# true | false — Set to true to globally unlock Enterprise tier capabilities for hackathon judges & evaluators
HACKATHON_MODE=false


# ── Vite Client API Base URL ──────────────────────────────────────────────────
# Base URL the React client (apps/client) uses when calling /api/* endpoints.
#
#   Local dev: leave empty — Vite's proxy forwards /api/* to localhost:3000
#              (configured in apps/client/vite.config.js)
#
#   Production: set to the full deployed URL (no trailing slash)
#               e.g. https://cavdax.sahnirmaan.live
VITE_API_URL=


# ── GitHub Token (optional — CLI only) ───────────────────────────────────────
# Used by the npx cavdax ingest --type issue command to fetch issue metadata
# from the GitHub API when --title / --body are not provided on the CLI.
#
# Required OAuth scopes: repo (read-only is sufficient)
# Generate at: https://github.com/settings/tokens
#
# This is NOT needed for the server or web HUD — only for the CLI ingestor.
GITHUB_TOKEN=


# ── GitHub OAuth App Configuration ──────────────────────────────────────────
# Enables the "Connect GitHub" integration throughout CAVDAX.
# Users authenticate with their GitHub account to inspect organizations and import ADRs.
#
# CRITICAL SECURITY NOTE (RFC 6749 COMPLIANCE & CREDENTIAL ISOLATION):
# GitHub strictly validates that the requested redirect URI matches the registered
# callback URL for the Client ID. Never mix production and localhost credentials.
#
# 1. PRODUCTION DEPLOYMENT (https://cavdax.sahnirmaan.live):
#    - Register an OAuth App at: https://github.com/settings/developers
#    - Application name:         CAVDAX (Production)
#    - Homepage URL:             https://cavdax.sahnirmaan.live
#    - Authorization callback:   https://cavdax.sahnirmaan.live/api/auth/github/callback
#    - GITHUB_CALLBACK_URL=https://cavdax.sahnirmaan.live/api/auth/github/callback
#    - CLIENT_URL=https://cavdax.sahnirmaan.live
#
# 2. LOCAL DOCKER & LOCAL DEVELOPMENT (http://localhost):
#    - Register a separate OAuth App at: https://github.com/settings/developers
#    - Application name:         CAVDAX (Local Dev)
#    - Homepage URL:             http://localhost:5173
#    - Authorization callback:   http://localhost:3001/api/auth/github/callback
#    - GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback
#    - CLIENT_URL=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
CLIENT_URL=


# ── Session Secret ────────────────────────────────────────────────────────────
# Signs the express-session cookie. Must be a long random string in production.
# Generate: openssl rand -hex 32
# If left blank, a random secret is generated at boot (sessions reset on restart).
SESSION_SECRET=



# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
# Used for the sponsor page (one-time payments) and Pro tier subscriptions.
#
# Get your keys at: https://dashboard.razorpay.com/app/keys
#   Test mode:  rzp_test_xxxxxxxxxxxx
#   Live mode:  rzp_live_xxxxxxxxxxxx
#
# RAZORPAY_KEY_SECRET must NEVER appear in frontend code or be committed to git.
# VITE_RAZORPAY_KEY_ID is the public key — safe to expose in the browser bundle.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Frontend: Vite exposes only VITE_* vars to the browser bundle.
# Set this to the same value as RAZORPAY_KEY_ID above.
VITE_RAZORPAY_KEY_ID=

# Razorpay Webhook Secret — separate from KEY_SECRET.
# Generate in Razorpay Dashboard → Webhooks → (your webhook) → "Regenerate Secret".
# Required to validate the X-Razorpay-Signature header on POST /api/billing/webhook.
RAZORPAY_WEBHOOK_SECRET=
