# Caddy Reverse Proxy Configuration
# Automatically secures your domain with a free Let's Encrypt SSL certificate.

cavdax.sahnirmaan.live, {$DOMAIN:localhost} {
    tls internal

    # /devteam route access control is managed via multi-factor IP whitelist & passkey in DevTeamPanel

    # 1. Route API requests and real-time SSE streams to CAVDAX Backend Server
    handle /api/* {
        reverse_proxy server:3000 {
            flush_interval -1
        }
    }

    # 2. Route all frontend Web HUD requests to the Client
    handle {
        reverse_proxy client:5173
    }

    @sounds path /sounds/*
    header @sounds {
        Cache-Control "public, max-age=31536000, immutable"
    }

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    encode gzip zstd

    # ── Upstream error handling (roadmap §6.3) ───────────────────────────────
    # When the Express backend container is restarting or unreachable, Caddy
    # returns a raw HTML 502/503/504. Replace it with a clean JSON envelope
    # so the Web HUD and CLI tools always get a parseable response on /api/*.
    handle_errors {
        @api_error {
            path /api/*
            expression `{err.status_code} in [502, 503, 504]`
        }
        handle @api_error {
            header Content-Type "application/json; charset=utf-8"
            respond `{"success":false,"error":{"code":"SERVICE_RESTARTING","message":"CAVDAX backend is temporarily unavailable. Retry in a few seconds.","subsystem":"caddy_gateway","remediable":true},"retry_after":5}` {err.status_code}
        }
    }
}
