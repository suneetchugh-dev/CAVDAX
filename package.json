{
  "name": "cavdax-monorepo",
  "version": "1.0.0",
  "description": "CAVDAX: Contextual Action & Verified Decision Autonomous eXecution",
  "type": "module",
  "scripts": {
    "server": "node apps/server/index.js",
    "client": "cd apps/client && npm run dev",
    "benchmark": "node benchmark/evaluate.js",
    "benchmark:scale": "node benchmark/scale_generator.js",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "seed": "curl -X POST http://localhost:3000/api/seed",
    "browser:open": "node scripts/browser-runner.js",
    "browser:edge": "node scripts/browser-runner.js --edge",
    "browser:debug": "powershell -ExecutionPolicy Bypass -File scripts/launch-signedin-browser.ps1",
    "test:e2e": "node scripts/browser-runner.js",
    "test:browser": "node scripts/test-signedin-browser.js"
  },
  "keywords": [
    "falkordb",
    "graphblas",
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "knowledge-graph",
    "causal-dag"
  ],
  "author": "Suneet Chugh & Geetika Chugh",
  "license": "GPL-3.0",
  "devDependencies": {
    "puppeteer-core": "^25.15.0"
  }
}
