# ============================================================
# CAVDAX Server Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
#
#   cp apps/server/.env.example apps/server/.env
#
# NEVER commit .env to git — it is already in .gitignore.
# ============================================================


# ── FalkorDB Connection ──────────────────────────────────────────────────────
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH_NAME=cavdax_core_graph


# ── Server Port ───────────────────────────────────────────────────────────────
PORT=3000


# ── CAVDAX Tier ───────────────────────────────────────────────────────────────
# free | pro | enterprise
CAVDAX_TIER=free


# ── MCP API Bearer Token ─────────────────────────────────────────────────────
# Protects all write endpoints. Leave blank in local dev.
# Generate: openssl rand -hex 32
MCP_API_TOKEN=


# ── Session Secret ────────────────────────────────────────────────────────────
# Signs the express-session cookie. Required in production.
# Generate: openssl rand -hex 32
SESSION_SECRET=


# ── GitHub OAuth App ──────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=


# ── GitHub Token (CLI only) ───────────────────────────────────────────────────
GITHUB_TOKEN=


# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
# Get keys at: https://dashboard.razorpay.com/app/keys
# Test:  rzp_test_xxxxxxxxxxxx
# Live:  rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret — copy from Razorpay Dashboard → Webhooks → Show Secret
# Must match the secret entered in the Razorpay webhook form.
RAZORPAY_WEBHOOK_SECRET=
